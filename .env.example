# Optional overrides for advanced local runs.
# The app normally reads user data from the in-app configuration screens
# and persists it under ./data/config.json.

# Optional AI/scoring override
OPENAI_API_KEY=

# Optional defaults if you prefer environment-based auth during development
LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=

# Optional automation overrides
RESUME_PATH=./data/resume.txt
DAILY_APPLICATION_CAP=50
EXECUTION_TIMEOUT_MS=1200000
